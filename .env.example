# Copy to .env.local and fill in. Never commit .env.local.
#
# Supabase dashboard → Project Settings → API (or `npx supabase status` for the local stack).
# Both values are safe in the browser: row level security protects the data, not the key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only for the database tests in supabase/tests and lib/repositories/supabase.test.ts.
# Point them at the LOCAL stack, never at the real project.
# DATABASE_TEST_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_ANON_KEY=
# SUPABASE_TEST_SERVICE_KEY=
