# Copy to .env.local. Never commit .env.local.
#
# The values below point at the LOCAL Supabase stack (`npm run db:start`, needs Docker). They are
# the Supabase CLI's fixed defaults for every local stack, not secrets, so a new member can run
# the app without any hosted credential. Local sign-in: demo@flashcards.local / demo-password
# (created by supabase/seed.sql).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# The hosted project is only used by the deployed app (#33). Its URL and publishable key go into
# the Vercel environment variables, not into this file or the repository:
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key from Project Settings → API>

# Only for the database tests in supabase/tests and lib/repositories/supabase.test.ts.
# Point them at the LOCAL stack, never at the real project. The service key is shown by
# `npm run db:status`.
# DATABASE_TEST_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# SUPABASE_TEST_SERVICE_KEY=
